#compdef sessionmanager

# zsh completion for sessionmanager

_sessionmanager() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '1: :->command' \
        '*::arg:->args'

    case $state in
        command)
            local -a commands
            commands=(
                'monitor:daemon control'
                'session:sessions'
                'report:reports'
                'macro:macros'
                'whitelist:whitelist'
                'cleanup:maintenance'
            )
            _describe -t commands 'sessionmanager commands' commands
            ;;
        args)
            case $line[1] in
                monitor)
                    _arguments \
                        '1: :(start stop status)'
                    ;;
                session)
                    local -a session_cmds
                    session_cmds=(
                        'start:start session'
                        'stop:end session'
                        'current:show info'
                    )
                    
                    if (( CURRENT == 2 )); then
                        _describe -t session-commands 'session commands' session_cmds
                    elif [[ $words[2] == "start" ]]; then
                        _arguments \
                            '--topic[topic]:topic:' \
                            '--description[description]:description:' \
                            '--duration[minutes]:duration:' \
                            '--macro[use macro]:macro:'
                    fi
                    ;;
                report)
                    if (( CURRENT == 2 )); then
                        _arguments \
                            '1: :(daily weekly)'
                    else
                        _arguments \
                            '--json[json output]'
                    fi
                    ;;
                macro)
                    local -a macro_cmds
                    macro_cmds=(
                        'list:list macros'
                        'create:create macro'
                        'delete:delete macro'
                        'run:run macro'
                    )
                    
                    if (( CURRENT == 2 )); then
                        _describe -t macro-commands 'macro commands' macro_cmds
                    else
                        case $words[2] in
                            create)
                                _arguments \
                                    '--name[name]:name:' \
                                    '--topic[topic]:topic:' \
                                    '--description[description]:description:' \
                                    '--duration[minutes]:duration:'
                                ;;
                            delete|run)
                                _arguments \
                                    '--name[name]:name:'
                                ;;
                        esac
                    fi
                    ;;
                whitelist)
                    local -a whitelist_cmds
                    whitelist_cmds=(
                        'list:list apps'
                        'add:add app'
                        'remove:remove app'
                    )
                    
                    if (( CURRENT == 2 )); then
                        _describe -t whitelist-commands 'whitelist commands' whitelist_cmds
                    else
                        case $words[2] in
                            add|remove)
                                _arguments \
                                    '--app[app class]:app:'
                                ;;
                        esac
                    fi
                    ;;
                cleanup)
                    _arguments \
                        '--days[keep days]:days:'
                    ;;
            esac
            ;;
    esac
}

_sessionmanager "$@"
