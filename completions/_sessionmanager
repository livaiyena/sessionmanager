#compdef sessionmanager

# zsh completion for sessionmanager

_sessionmanager() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '1: :->command' \
        '*::arg:->args'

    case $state in
        command)
            local -a commands
            commands=(
                'monitor:monitor daemon control'
                'session:session management'
                'report:activity reports'
                'macro:macro management'
                'whitelist:protected apps management'
            )
            _describe -t commands 'sessionmanager commands' commands
            ;;
        args)
            case $line[1] in
                monitor)
                    _arguments \
                        '1: :(start stop status)'
                    ;;
                session)
                    local -a session_cmds
                    session_cmds=(
                        'start:start work session'
                        'stop:end current session'
                        'current:show current session info'
                    )
                    
                    if (( CURRENT == 2 )); then
                        _describe -t session-commands 'session commands' session_cmds
                    elif [[ $words[2] == "start" ]]; then
                        _arguments \
                            '--topic[session topic]:topic:' \
                            '--description[session description]:description:' \
                            '--duration[duration in minutes]:duration:' \
                            '--macro[use saved macro]:macro:'
                    fi
                    ;;
                report)
                    _arguments \
                        '1: :(daily weekly)'
                    ;;
                macro)
                    local -a macro_cmds
                    macro_cmds=(
                        'list:list saved macros'
                        'create:create new macro'
                        'delete:delete macro'
                        'run:run saved macro'
                    )
                    
                    if (( CURRENT == 2 )); then
                        _describe -t macro-commands 'macro commands' macro_cmds
                    else
                        case $words[2] in
                            create)
                                _arguments \
                                    '--name[macro name]:name:' \
                                    '--topic[session topic]:topic:' \
                                    '--description[session description]:description:' \
                                    '--duration[duration in minutes]:duration:'
                                ;;
                            delete|run)
                                _arguments \
                                    '--name[macro name]:name:'
                                ;;
                        esac
                    fi
                    ;;
                whitelist)
                    local -a whitelist_cmds
                    whitelist_cmds=(
                        'list:list protected applications'
                        'add:add protected app'
                        'remove:remove protected app'
                    )
                    
                    if (( CURRENT == 2 )); then
                        _describe -t whitelist-commands 'whitelist commands' whitelist_cmds
                    else
                        case $words[2] in
                            add|remove)
                                _arguments \
                                    '--app[application class]:app:'
                                ;;
                        esac
                    fi
                    ;;
            esac
            ;;
    esac
}

_sessionmanager "$@"
