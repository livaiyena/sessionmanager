# .gitignore for sessionmanager

# python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# virtual environments
venv/
ENV/
env/

# ide
.vscode/
.idea/
*.swp
*.swo
*~

# mac
.DS_Store

# local data (users will have this in ~/.local/share/sessionmanager/)
*.db
*.pid
whitelist.txt

# aur build files
*.tar.gz
*.tar.xz
pkg/
src/
*.src.tar.gz
