#!/usr/bin/env python3

"""
session manager and activity tracker for hyprland
main entry point - installed to /usr/bin/sessionmanager
"""

import sys
import argparse
from sessionmanager.cli import CLI



def main():
    """main entry point"""
    parser = argparse.ArgumentParser(
        description='activity tracker for hyprland'
    )
    subparsers = parser.add_subparsers(dest='command', help='commands')
    
    # monitor
    monitor_parser = subparsers.add_parser('monitor', help='daemon control')
    monitor_subparsers = monitor_parser.add_subparsers(dest='action')
    monitor_subparsers.add_parser('start', help='start daemon')
    monitor_subparsers.add_parser('stop', help='stop daemon')
    monitor_subparsers.add_parser('status', help='daemon status')
    
    # session
    session_parser = subparsers.add_parser('session', help='sessions')
    session_subparsers = session_parser.add_subparsers(dest='action')
    
    start_parser = session_subparsers.add_parser('start', help='start session')
    start_parser.add_argument('--topic', help='topic')
    start_parser.add_argument('--description', help='description')
    start_parser.add_argument('--duration', type=int, help='minutes')
    start_parser.add_argument('--macro', help='use macro')
    
    session_subparsers.add_parser('stop', help='end session')
    session_subparsers.add_parser('current', help='show info')
    
    # report
    report_parser = subparsers.add_parser('report', help='reports')
    report_subparsers = report_parser.add_subparsers(dest='action')
    daily_parser = report_subparsers.add_parser('daily', help='daily summary')
    daily_parser.add_argument('--json', action='store_true', help='json output')
    
    weekly_parser = report_subparsers.add_parser('weekly', help='weekly summary')
    weekly_parser.add_argument('--json', action='store_true', help='json output')
    
    # macro
    macro_parser = subparsers.add_parser('macro', help='macros')
    macro_subparsers = macro_parser.add_subparsers(dest='action')
    macro_subparsers.add_parser('list', help='list macros')
    
    create_parser = macro_subparsers.add_parser('create', help='create macro')
    create_parser.add_argument('--name', required=True, help='name')
    create_parser.add_argument('--topic', required=True, help='topic')
    create_parser.add_argument('--description', required=True, help='description')
    create_parser.add_argument('--duration', type=int, required=True, help='minutes')
    
    delete_parser = macro_subparsers.add_parser('delete', help='delete macro')
    delete_parser.add_argument('--name', required=True, help='name')
    
    run_parser = macro_subparsers.add_parser('run', help='run macro')
    run_parser.add_argument('--name', required=True, help='name')
    
    # cleanup
    cleanup_parser = subparsers.add_parser('cleanup', help='maintenance')
    cleanup_parser.add_argument('--days', type=int, default=30, help='keep days (default 30)')
    
    # whitelist
    whitelist_parser = subparsers.add_parser('whitelist', help='whitelist')
    whitelist_subparsers = whitelist_parser.add_subparsers(dest='action')
    whitelist_subparsers.add_parser('list', help='list apps')
    
    add_whitelist_parser = whitelist_subparsers.add_parser('add', help='add app')
    add_whitelist_parser.add_argument('--app', required=True, help='app class')
    
    remove_whitelist_parser = whitelist_subparsers.add_parser('remove', help='remove app')
    remove_whitelist_parser.add_argument('--app', required=True, help='app class')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    cli = CLI()
    
    # route
    if args.command == 'monitor':
        if args.action == 'start':
            cli.monitor_start()
        elif args.action == 'stop':
            cli.monitor_stop()
        elif args.action == 'status':
            cli.monitor_status()
        else:
            monitor_parser.print_help()
    
    elif args.command == 'session':
        if args.action == 'start':
            if args.macro:
                cli.session_start(None, None, None, macro=args.macro)
            elif args.topic and args.description and args.duration:
                cli.session_start(args.topic, args.description, args.duration)
            else:
                print("error: use --macro or --topic --description --duration")
                start_parser.print_help()
        elif args.action == 'stop':
            cli.session_stop()
        elif args.action == 'current':
            cli.session_current()
        else:
            session_parser.print_help()
    
    elif args.command == 'report':
        if args.action == 'daily':
            cli.report_daily(args.json)
        elif args.action == 'weekly':
            cli.report_weekly(args.json)
        else:
            report_parser.print_help()
    
    elif args.command == 'macro':
        if args.action == 'list':
            cli.macro_list()
        elif args.action == 'create':
            cli.macro_create(args.name, args.topic, args.description, args.duration)
        elif args.action == 'delete':
            cli.macro_delete(args.name)
        elif args.action == 'run':
            cli.macro_run(args.name)
        else:
            macro_parser.print_help()
    
    elif args.command == 'cleanup':
        cli.cleanup(args.days)
    
    elif args.command == 'whitelist':
        if args.action == 'list':
            cli.whitelist_list()
        elif args.action == 'add':
            cli.whitelist_add(args.app)
        elif args.action == 'remove':
            cli.whitelist_remove(args.app)
        else:
            whitelist_parser.print_help()


if __name__ == '__main__':
    main()

